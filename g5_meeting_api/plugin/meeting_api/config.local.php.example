// define('meeting_MB_PASSWORD', '');               // 비우면 setup 시 임의 생성(1회 표시)
// define('meeting_MB_LEVEL', 2);                   // 기본 2(일반 회원). 게시판 글쓰기 레벨 이상으로
//
// 2) 계정 자동 생성: meeting_API_ALLOW_SETUP=true 로 두고 setup_member.php 를 1회 POST 호출.
//    (그누보드 관리자에서 직접 회원을 만들어도 됨 — 그 경우 setup_member.php 불필요)
// 3) 확인 후 meeting_API_ALLOW_SETUP 를 false 로 되돌리거나 setup_*.php 삭제.
//
// meeting_MB_ID 를 비워두면 기존처럼 비회원(게스트) 글로 등록된다(하위 호환).

